{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-investigator-bash.mjs"
            ]
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "review-change@claude-code-node-lab": true
  },
  "extraKnownMarketplaces": {
    "claude-code-node-lab": {
      "source": {
        "source": "git",
        "url": "https://github.com/claudiocarvalho16/claude-code-node-lab.git"
      }
    }
  }
}
